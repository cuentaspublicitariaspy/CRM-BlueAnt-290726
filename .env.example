# Example environment configuration
APP_ENV=development
DB_SERVER=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=crm_local
OPENAI_API_KEY=

# Optional test database configuration
DB_TEST_DSN=mysql:host=localhost;dbname=u963040303_crm_blueant;charset=utf8mb4
DB_TEST_USER=root
DB_TEST_PASSWORD=

# Módulo Agenda: clave para encriptar credenciales SMTP/Twilio guardadas en BD.
# Generar con: php -r "echo base64_encode(random_bytes(32));"
AGENDA_ENCRYPTION_KEY=

# Módulo Agenda: secreto para invocar cron/agenda-reminders.php por URL en
# hosting que solo permite cron vía HTTP (no hace falta si el cron corre por CLI).
AGENDA_CRON_SECRET=

# Módulo Agenda: user_id de la cuenta bajo la cual viven sucursal/recursos/
# servicios/reservas (CRM de un solo negocio, sin selector de negocio en la
# UI). Difiere entre entornos porque cada base de `users` tiene sus propios
# IDs — sin este valor, cae al fallback de dev local (2), que casi seguro NO
# es correcto en producción.
AGENDA_BUSINESS_OWNER_USER_ID=
